# Line endings.
#
# Shell scripts MUST keep LF. A CRLF entrypoint.sh makes the kernel read the
# shebang as "#!/bin/sh\r" and look for an interpreter literally called
# "/bin/sh\r", which fails at container start with the thoroughly misleading:
#
#   exec /entrypoint.sh: no such file or directory
#
# Without this file, a checkout on Windows (or anywhere with
# core.autocrlf=true) rewrites them and the container will not boot.

* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.mako      text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary
*.gz   binary
